# Files NOT shipped to the server by `git archive`
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
tests export-ignore
docs export-ignore
render.yaml export-ignore

# Shell/JS deploy files must keep Linux line endings (Windows CRLF breaks bash scripts)
*.sh text eol=lf
*.js text eol=lf
*.yml text eol=lf