# /etc/sixstar/migration.env (root only, chmod 600).
# Production Atlas source. Keep the existing production connection string here.
ATLAS_URI=mongodb+srv://USER:PASSWORD@production-cluster.example.mongodb.net/PRODUCTION_DB?retryWrites=true&w=majority
# Optional production database override.
# ATLAS_DB=

# Staging Atlas source. Set this to the staging Atlas connection string.
STAGING_ATLAS_URI=mongodb+srv://USER:PASSWORD@staging-cluster.example.mongodb.net/STAGING_DB?retryWrites=true&w=majority
# Optional staging database override.
# STAGING_ATLAS_DB=
