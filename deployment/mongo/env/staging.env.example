NODE_ENV=staging
# STAGING_MONGODB_URI from /etc/sixstar/mongo-admin.env (database sixstar_staging, its own least-privilege user). NEVER the production URI.
MONGODB_URI=mongodb://sixstar_staging_app:<generated>@127.0.0.1:27017/sixstar_staging?replicaSet=rs0&authSource=sixstar_staging&retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_staging_only
JWT_REFRESH_SECRET=CHANGE_ME_staging_only_2
MPESA_ENVIRONMENT=sandbox
ETIMS_ENVIRONMENT=sandbox
# Leave SMS / PayHero live keys EMPTY in staging.
