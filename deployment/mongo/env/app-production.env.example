# Production app env files (blue.env / green.env / worker.env). The cutover tool rewrites ONLY the MONGODB_URI line, after keeping a copy.
# Local, authenticated, replica-set connection (generated by install-mongodb.sh into /etc/sixstar/mongo-admin.env as APP_MONGODB_URI):
# MONGODB_URI=mongodb://sixstar_app:<generated>@127.0.0.1:27017/<db>?replicaSet=rs0&authSource=<db>&retryWrites=true&w=majority
#
# Optional tuning (defaults shown) - read by src/config/db.js:
# MONGO_MAX_POOL=20
# MONGO_SERVER_SELECTION_MS=15000
# MONGO_CONNECT_RETRIES=3
